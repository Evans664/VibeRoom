rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mirrors docs/contracts/PLAYLISTS.md: at most 500 song IDs per playlist.
    function isValidPlaylist(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.songIds is list && data.songIds.size() <= 500;
    }

    // User profiles & preferences (owned by individual user)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Playlists (owned by creator, read if public or owned)
    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid
        && isValidPlaylist(request.resource.data);
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && isValidPlaylist(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Liked songs (user-specific subcollection)
    match /likes/{userId}/songs/{songId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Recently played track history (user-specific subcollection)
    match /recentlyPlayed/{userId}/tracks/{trackId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Saved albums (user-specific subcollection)
    match /savedAlbums/{userId}/albums/{albumId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Catch-all deny rule for any unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
